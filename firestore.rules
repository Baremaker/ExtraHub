rules_version = '2';

// =====================================================================
// ExtraHub — Cloud Firestore Security Rules
// ---------------------------------------------------------------------
// Estratégia:
//   * Tudo é negado por default.
//   * Usuário precisa estar autenticado E ter email @usp.br para qualquer
//     operação (validado em isAuthed()).
//   * Membros leem dados de SUAS extras. Admins escrevem. Owner manda no
//     próprio mandato.
//   * Funções helper centralizam checks repetidos.
// ---------------------------------------------------------------------
// Limites a lembrar:
//   * Cada `get()`/`exists()` numa rule conta como 1 read e tem custo.
//   * Máximo 10 chamadas a get/exists por request.
//   * Funções não suportam recursão.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPERS ──────────────────────────────────────────────────────
    // Logado com e-mail @usp.br, SEM exigir verificação. Usado apenas na
    // criação do próprio doc users/{uid} no signup (antes da verificação).
    function isUspEmail() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email.matches('.*@usp[.]br$');
    }

    // Acesso pleno: e-mail @usp.br E verificado. Padrão para tudo, exceto o
    // create de users/{uid}.
    function isAuthed() {
      return isUspEmail() && request.auth.token.email_verified == true;
    }

    function isSelf(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    function memberDoc(extraId) {
      return get(/databases/$(database)/documents/extras/$(extraId)/members/$(request.auth.uid));
    }

    function isMember(extraId) {
      return isAuthed()
          && exists(/databases/$(database)/documents/extras/$(extraId)/members/$(request.auth.uid))
          && memberDoc(extraId).data.status == 'active';
    }

    function isAdmin(extraId) {
      return isMember(extraId) && memberDoc(extraId).data.role == 'admin';
    }

    function isOwner(extraId) {
      return isAdmin(extraId) && memberDoc(extraId).data.isOwner == true;
    }

    // Verifica se um campo NÃO foi alterado (para imutabilidade parcial).
    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // ─── CONVITES (helpers) ───────────────────────────────────────────
    // Convite tem id determinístico: invites/{extraId}__{email}. Isso permite
    // a rule localizar o convite do usuário atual sem conhecer um id aleatório,
    // e assim autorizar o convidado a criar o próprio membership ao aceitar.
    function inviteDoc(extraId) {
      return get(/databases/$(database)/documents/invites/$(extraId + '__' + request.auth.token.email));
    }
    function hasValidInvite(extraId) {
      return isAuthed()
          && exists(/databases/$(database)/documents/invites/$(extraId + '__' + request.auth.token.email))
          && inviteDoc(extraId).data.status == 'pending'
          && request.time < inviteDoc(extraId).data.expiresAt;
    }

    // =================================================================
    // USERS
    // =================================================================
    match /users/{uid} {
      // Qualquer usuário autenticado pode ler perfis (necessário para
      // resolver author de avisos, líder de projeto, etc.). Não há dado
      // sensível além de email @usp.br.
      allow read: if isAuthed();

      // Criação no signup: precisa ser ANTES da verificação de e-mail (senão o
      // perfil nunca é criado e o usuário trava no fluxo). Exige @usp.br e que
      // o doc seja do próprio user.
      allow create: if isUspEmail()
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && request.resource.data.email == request.auth.token.email;

      // Atualização: só o próprio. Campos imutáveis: uid, email, createdAt.
      allow update: if isSelf(uid)
                    && unchanged('uid')
                    && unchanged('email')
                    && unchanged('createdAt');

      // Sem delete via cliente.
      allow delete: if false;
    }

    // =================================================================
    // EXTRAS
    // =================================================================
    match /extras/{extraId} {
      // Ler: precisa ser membro ativo.
      allow read: if isMember(extraId);

      // Criar: qualquer usuário autenticado pode criar uma nova extra.
      // Quem cria automaticamente é o owner — mas isso é validado pela
      // criação simultânea do doc em members (em transaction no client).
      allow create: if isAuthed()
                    && request.resource.data.ownerId == request.auth.uid;

      // Atualizar:
      //   * Admins: alteram a extra (createdAt imutável; ownerId só o owner).
      //   * Convidado entrando agora: pode SÓ incrementar memberCount (+1) e
      //     updatedAt, e somente se tiver um convite pendente válido.
      allow update: if (isAdmin(extraId)
                        && unchanged('createdAt')
                        && (unchanged('ownerId') || isOwner(extraId)))
                    || (hasValidInvite(extraId)
                        && request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly(['memberCount', 'updatedAt'])
                        && request.resource.data.memberCount
                            == resource.data.memberCount + 1);

      // Deletar: apenas owner. (Cuidado: subcollections precisam ser
      // limpadas separadamente — Firestore não cascata.)
      allow delete: if isOwner(extraId);

      // ─── MEMBERS ──────────────────────────────────────────────────
      match /members/{memberUid} {
        allow read: if isMember(extraId);

        // Criação, em 3 cenários:
        //   1. Admin convidando/adicionando alguém manualmente.
        //   2. Dono criando a extra: o membership é criado no MESMO batch que a
        //      extra, então usamos getAfter() (get() não enxergaria a extra
        //      recém-criada na mesma transação).
        //   3. Convidado aceitando: cria o PRÓPRIO membership (isOwner=false)
        //      desde que exista convite pendente válido e o papel bata.
        allow create: if isAuthed()
                      && (isAdmin(extraId)
                          || (isSelf(memberUid)
                              && request.resource.data.role == 'admin'
                              && request.resource.data.isOwner == true
                              && getAfter(/databases/$(database)/documents/extras/$(extraId)).data.ownerId == request.auth.uid)
                          || (isSelf(memberUid)
                              && request.resource.data.isOwner == false
                              && hasValidInvite(extraId)
                              && request.resource.data.role == inviteDoc(extraId).data.role));

        // Atualização:
        //   * Admin pode alterar role/status/position de qualquer membro
        //     (exceto o próprio owner, que só ele mexe em si).
        //   * O próprio user pode atualizar campos limitados (position,
        //     inProjectIds, displayName/photoURL para sincronizar com
        //     o perfil global).
        allow update: if isAuthed() && (
          (isAdmin(extraId)
            && (memberDoc(extraId).data.isOwner != true || isSelf(memberUid))
            && unchanged('uid')
            && unchanged('joinedAt'))
          || (isSelf(memberUid)
            && unchanged('uid') && unchanged('email')
            && unchanged('role') && unchanged('isOwner')
            && unchanged('status') && unchanged('joinedAt'))
        );

        // Deletar membro: apenas admin, e nunca o owner.
        allow delete: if isAdmin(extraId)
                      && resource.data.isOwner != true;
      }

      // ─── PROJECTS ─────────────────────────────────────────────────
      match /projects/{projectId} {
        allow read: if isMember(extraId);
        allow create: if isAdmin(extraId);
        // Atualizar: admin OU dono do projeto (líder).
        allow update: if isAdmin(extraId)
                      || (isMember(extraId)
                          && resource.data.ownerId == request.auth.uid);
        allow delete: if isAdmin(extraId);
      }

      // ─── ANNOUNCEMENTS ────────────────────────────────────────────
      match /announcements/{announcementId} {
        allow read: if isMember(extraId);
        allow create: if isAdmin(extraId)
                      && request.resource.data.author.uid == request.auth.uid;
        allow update: if isAdmin(extraId)
                      && unchanged('author')
                      && unchanged('createdAt');
        allow delete: if isAdmin(extraId);
      }

      // ─── EVENTS ───────────────────────────────────────────────────
      match /events/{eventId} {
        allow read: if isMember(extraId);
        allow create: if isAdmin(extraId)
                      && request.resource.data.createdBy == request.auth.uid;
        allow update: if isAdmin(extraId);
        allow delete: if isAdmin(extraId);
      }
    }

    // =================================================================
    // INVITES (top-level)
    // =================================================================
    match /invites/{inviteId} {
      // Ler: o destinatário (pelo email) ou um admin da extra-alvo.
      allow read: if isAuthed()
                  && (resource.data.email == request.auth.token.email
                      || isAdmin(resource.data.extraId));

      // Criar: admin da extra que está convidando.
      allow create: if isAuthed()
                    && isAdmin(request.resource.data.extraId)
                    && request.resource.data.invitedBy.uid == request.auth.uid
                    && request.resource.data.status == 'pending';

      // Atualizar: o destinatário pode mudar status para accepted/declined.
      // Admin da extra também pode (cancelar etc).
      allow update: if isAuthed() && (
        (resource.data.email == request.auth.token.email
          && unchanged('email')
          && unchanged('extraId')
          && unchanged('role')
          && unchanged('invitedBy')
          && unchanged('createdAt')
          && (request.resource.data.status == 'accepted'
              || request.resource.data.status == 'declined'))
        || isAdmin(resource.data.extraId)
      );

      // Deletar: admin da extra-alvo.
      allow delete: if isAuthed() && isAdmin(resource.data.extraId);
    }
  }
}
